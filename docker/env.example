# PR Agent GitLab Webhook 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp env.example .env

# ============================================
# 必需配置
# ============================================

# DeepSeek API 密钥
# 获取地址: https://platform.deepseek.com/
DEEPSEEK__KEY=your-deepseek-api-key

# GitLab 个人访问令牌
# 在 GitLab -> User Settings -> Access Tokens 创建
# 需要的权限: api, read_repository, write_repository
GITLAB__PERSONAL_ACCESS_TOKEN=glpat-your-token-here

# GitLab Webhook 验证密钥
# 在 GitLab 项目 -> Settings -> Webhooks 中设置相同的值
GITLAB__SHARED_SECRET=your-webhook-secret

# GitLab 服务器地址
GITLAB__URL=http://gitlab.camera360.com

# ============================================
# 可选配置
# ============================================

# 服务端口（默认 3000）
PORT=3000

# AI 模型配置
CONFIG__MODEL=deepseek/deepseek-chat

# 响应语言（默认中文）
CONFIG__RESPONSE_LANGUAGE=zh-CN

# ============================================
# 高级配置（一般无需修改）
# ============================================

# AI 超时时间（秒）
# CONFIG__AI_TIMEOUT=120

# 日志级别: DEBUG, INFO, WARNING, ERROR
# CONFIG__LOG_LEVEL=DEBUG

# 最大模型 token 数
# CONFIG__MAX_MODEL_TOKENS=64000
